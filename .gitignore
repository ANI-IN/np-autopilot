# Google Drive credentials — never commit
config/credentials.json
config/token.json
config/drive.yaml

# Service-account keys. The key belongs OUTSIDE the repo, referenced by path
# through $NP_DRIVE_SA_KEY and chmod 600 — never copied in here. These patterns
# exist because one was found at the repo root, mode 0644 and unignored, where
# `git add -A` would have committed it. A key that cannot be staged cannot be
# leaked by a careless commit; that is the whole job of this block.
/*.json
np-autopilot-*.json
*service-account*.json
*service_account*.json
*-sa-key*.json
gcp-*.json

# Environment files. Supabase connection strings and the service-role key are
# secrets; they belong in a file outside the repo (mode 600), named by path.
.env
.env.*
!.env.example

# Local corpus cache, fetched by pipeline/00_fetch_drive.py
.drive-cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

.DS_Store

# ---------------------------------------------------------------------------
# THE CORPUS IS NEVER COMMITTED.
# 75 source files holding ~8,000 learner names and personal emails, employee
# performance records, and a payroll export with termination records. The plugin
# does not bundle the corpus (doc 08 Q7) — teammates get knowledge/ only.
# Committing these would recreate exactly the exposure documented in doc 04.
# ---------------------------------------------------------------------------
00-master/
01-workflows/
02-curriculum/
03-instructors/
04-programs/
05-operations/
06-analysis/

# Local corpus cache from pass 0
.drive-cache/
