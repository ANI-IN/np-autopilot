# np-autopilot — environment. NAMES AND DESCRIPTIONS ONLY, never values.
# Copy to .env (gitignored) or set these in the Vercel project settings.

# --- Supabase -------------------------------------------------------------
# Session pooler, port 5432. Migrations and the projection loader only.
SUPABASE_DB_URL_SESSION=

# Transaction pooler, port 6543. EVERYTHING serverless. psycopg must run with
# prepare_threshold=None; transaction-mode pooling cannot hold prepared
# statements across statements.
SUPABASE_DB_URL_TRANSACTION=

# NEVER set the direct db.<ref>.supabase.co:5432 connection anywhere. It is
# IPv6-only on this project: it works on a laptop and fails on Vercel, which is
# the worst possible failure distribution. pipeline/lib/db.py refuses it.

# The SERVICE ROLE KEY is deliberately absent. Nothing in the web app needs it:
# every request runs as `authenticated` with the caller's claims so RLS applies.
# If you find yourself wanting it here, that is the signal a query is trying to
# bypass a policy rather than satisfy one.

# --- Google Workspace OAuth ----------------------------------------------
# The audience an ID token must carry. A token minted for another app is
# rejected on this alone.
GOOGLE_OAUTH_CLIENT_ID=

# The hosted-domain claim required on every token. NOT parsed from the email:
# a consumer Google account can carry an address in the domain.
NP_ALLOWED_HD=interviewkickstart.com

# Comma-separated local parts of KNOWN SHARED mailboxes, e.g.
# b2c-courses-new-programs. These resolve several humans to one identity, so the
# audit log names an account rather than a person. See docs/AUTH.md.
NP_SHARED_ACCOUNTS=

# --- Pipeline (not needed by the web app) --------------------------------
# NP_CORPUS_PATH   corpus root; defaults to the repo root
# NP_BUILD_LOG     where a pass appends its run record
# NP_AS_OF         date pass 4 treats as "now"; pins a historical rebuild
# NP_DRIVE_SA_KEY  PATH to the Drive service-account key, never the key itself
